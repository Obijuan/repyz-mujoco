<mujoco model="repyz">
    <option timestep="0.005" />

    <visual>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300" mark="edge" markrgb=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
        
        <material name="plastic" rgba="0.1 0.4 0.8 1" specular="0.1" shininess="0.1"/>
        <material name="servo_mat" rgba="0.2 0.2 0.2 1" specular="0.1" shininess="0.1"/>
        <material name="horn_mat" rgba="0.8 0.8 0.8 1" specular="0.1" shininess="0.1"/>
        
        <mesh name="repyz_body" file="stl/repyz-body.stl" scale="0.001 0.001 0.001"/>
        <mesh name="repyz_head" file="stl/repyz-head.stl" scale="0.001 0.001 0.001"/>
        <mesh name="servo" file="stl/futaba_witout_lower_cover.stl" scale="0.001 0.001 0.001"/>
        <mesh name="cover" file="stl/servo_lower_cover_fake_shaft.stl" scale="0.001 0.001 0.001"/>
        <mesh name="horn" file="stl/futaba_rounded_horn.stl" scale="0.001 0.001 0.001"/>
    </asset>

    <worldbody>
        <!-- La luz se ha quitado porque mjviser inyecta las suyas propias y deslumbraba -->
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" type="plane" size="0 0 .05" material="grid" condim="3"/>

        <!-- Rotamos todo 90 grados para que el módulo empiece en horizontal -->
        <!-- Y lo elevamos para que apoye en el suelo (Evitamos colisiones al inicio) -->
        <body name="link1" pos="0 0 0.04"  euler="90 0 0">
            <freejoint/>

            <geom type="mesh" mesh="repyz_body" euler="-0 0 0 " material="plastic" mass="0.05"/>
            
            <geom type="mesh" mesh="servo" pos="-0.012 0.0 0.03" euler="-90 90 180" material="servo_mat" mass="0.05"/>
            
            <body name="link2" pos="-0.0002789 0 0.08">
                <!-- Eje de rotación sobre Z, ya que el servo está vertical -->
                <joint name="servo_joint" type="hinge" pos="-0.01 0 -0.04" axis="1 0 0" range="-90 90" limited="true" damping="0.01"/>
                
                <!-- La cabeza repyz_head abrazará el servo por arriba y por abajo. -->
                <!-- Sus brazos se separan en X. Rotamos 90 en Y (euler="0 90 0") para que X apunte a Z. -->
                <!-- Ademas, como el spline esta arriba y el agujero puede estar invertido, si la cara no nos cuadra le damos offset. -->
                <geom type="mesh" mesh="repyz_head" pos="0 0 0" euler="180 0 0" material="plastic" mass="0.05"/>
            </body>
        </body>
    </worldbody>

     <actuator>
        <position joint="servo_joint" name="servo_actuator" kp="0.8" ctrlrange="-0.2 0.8" ctrllimited="true"/>
    </actuator>

    
</mujoco>